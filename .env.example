# --- REQUIRED API KEYS ---

# Alpha Vantage (Get for free: https://www.alphavantage.co/support/#api-key)
# Used for: Real-time quotes, company overviews, and chart history.
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Finnhub (Get for free: https://finnhub.io/register)
# Used for: Analyst recommendation trends and market news.
FINNHUB_API_KEY=your_finnhub_key_here

# NewsAPI / TheNewsAPI
# Used for: market headlines before falling back to Yahoo Finance search.
NEWSAPI_KEY=your_newsapi_key_here
THENEWSAPI_KEY=your_thenewsapi_key_here

# Financial Modeling Prep
# Used for: stock news and future transcripts/press releases.
FMP_API_KEY=your_fmp_key_here

# OpenRouter-compatible model key.
# Used for: Plain-English financial explanations and summaries.
GEMINI_API_KEY=your_gemini_key_here

# SerpApi (Get for free: https://serpapi.com/users/sign_up)
# Used for: Google Finance Markets failsafe/fallback data.
SERPAPI_KEY=your_serpapi_key_here

# EODHD (Get for free: https://eodhd.com/register)
# Used for: market data fallback and expanded equities coverage.
EODHD_API_KEY=your_eodhd_key_here

# NewsData.io (Get for free: https://newsdata.io/register)
# Used for: additional headline/news fallback coverage.
NEWSDATA_API_KEY=your_newsdata_key_here

# Massive / Polygon-compatible market data provider.
# Used for: optional expanded market-data coverage.
MASSIVE_API_KEY=your_massive_key_here

# Apify
# Used for: optional scraper-backed data collection workflows.
APIFY_API_KEY=your_apify_key_here

# SEC EDGAR does not require a key, but it expects a descriptive User-Agent.
# Use your app name and contact email.
SEC_USER_AGENT=macroliberium your_email@example.com

# Google login via NextAuth.
# Create credentials in Google Cloud Console and set the callback to:
# http://localhost:3000/api/auth/callback/google for local development.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# --- OPTIONAL CONFIG ---

# Set to 'true' to use local mock data instead of live API calls (good for development).
USE_MOCK_DATA=false

# Root URL (Required for server-side fetches in Next.js 14+)
# On Vercel, this is automatically handled via NEXT_PUBLIC_URL logic.
# For local dev, this defaults to http://localhost:3000.
NEXT_PUBLIC_URL=http://localhost:3000
